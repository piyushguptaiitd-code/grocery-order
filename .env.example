# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your family group's Telegram chat ID — bot will ONLY respond to this group.
# To find it: add @userinfobot to your group, it will print the chat ID (negative number e.g. -1001234567890)
TELEGRAM_GROUP_ID=-1001234567890

# Zepto account phone number (used for /login command)
ZEPTO_PHONE=+919876543210

# Database path
DATABASE_PATH=grocery_bot.db

# Encryption key for storing credentials securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_fernet_key_here

# Selenium: set to False to see the browser (useful for debugging)
SELENIUM_HEADLESS=True
